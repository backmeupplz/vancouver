# compose.yaml only: the nginx image's entrypoint renders this template into /etc/nginx/dev.d/dev.conf, which
# nginx.conf's server block includes; the image itself ships without it.

# /live (visitor counts, multiplayer WebSocket) → the `live` service, the way the page finds it in production
location /live/ {
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off; # the container's own DNS (Docker or Podman), so nginx starts (and recovers) while `live` is down
  set $live_upstream live:8080;
  proxy_pass http://$live_upstream;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header X-Real-IP $remote_addr;
  proxy_read_timeout 1h;
}

# map tiles missing from public/tiles (nothing baked yet) come from the live site, which serves them to anyone
# (CORS *). Bake locally (compose.yaml's `bake`) and your own tiles win, index.json included.
error_page 404 = @tiles;
location @tiles {
  if ($request_uri !~ ^/tiles/) { return 404; }
  set $tiles_host vancouver.borodutch.com;
  proxy_pass https://$tiles_host$request_uri;
  proxy_set_header Host $tiles_host;
  proxy_ssl_server_name on;
  proxy_ssl_name $tiles_host;
  proxy_set_header Cookie "";
}
